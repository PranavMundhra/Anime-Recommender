# Copy this file to .env, then add your keys locally.
# Only the key for your selected provider is required.
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Provider model names can be changed without editing Python code.
GEMINI_MODEL=gemini-3.1-flash-lite
MISTRAL_MODEL=mistral-large-latest

# Work budgets and cache policy. These defaults keep requests bounded.
CANDIDATE_BUDGET=50
CATALOGUE_CACHE_TTL=86400
CATALOGUE_TIMEOUT=10
CATALOGUE_RETRIES=2
LLM_TIMEOUT=30
EMBEDDING_MODEL=all-MiniLM-L6-v2
